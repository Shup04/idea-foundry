{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Idea Foundry discovery card v1",
  "description": "Application-level data contract. Provider generation constraints may need a supported subset. Semantic source support must be checked separately.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "observation",
        "provocation",
        "connection",
        "revisit",
        "wildcard"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "premise": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "assumption_to_challenge": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_relevance": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "user_statement",
              "supported",
              "inferred",
              "speculative",
              "needs_research"
            ]
          },
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "text",
          "status",
          "source_refs"
        ]
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_probe": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "premise",
    "mechanism",
    "assumption_to_challenge",
    "human_relevance",
    "source_refs",
    "claims",
    "uncertainties",
    "next_probe"
  ]
}
